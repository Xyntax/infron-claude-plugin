    "test:release": "INFRON_RUN_RELEASE=1 vitest run tests/release"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "msw": "^2.3.0",
    "vitest": "^2.0.0"
  }
}
