{
  "name": "@infron-ai/claude-plugin-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server for the Infron Claude plugin.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
